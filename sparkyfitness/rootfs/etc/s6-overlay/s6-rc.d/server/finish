#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: SparkyFitness
# Takes down the S6 supervision tree when the server stops
# ==============================================================================
declare -r service="SparkyFitness server"
declare exit_code

# 256 means the service was killed by a signal, which is expected while the
# add-on is shutting down.
if [[ "${1}" -eq 256 ]]; then
    if [[ "${2}" -eq 15 || "${2}" -eq 2 ]]; then
        bashio::log.info "${service} stopped"
        exit 0
    fi
    exit_code=$((128 + ${2}))
else
    exit_code="${1}"
fi

if [[ "${exit_code}" -ne 0 ]]; then
    bashio::log.warning "${service} exited with code ${exit_code}"
    echo "${exit_code}" > /run/s6-linux-init-container-results/exitcode
else
    bashio::log.info "${service} exited"
fi

# Nothing else works without this service, so bring the container down and let
# Home Assistant apply its restart policy.
exec /run/s6/basedir/bin/halt
